# Copy to .env and fill in. Real environment variables take precedence over this file.

# Discord bot token (required)
BOT_TOKEN=
# Discord application ID (required; command deploy and emoji upload)
DISCORD_APPLICATION_ID=
# MyAnimeList API client ID (required; myanimelist.net/apiconfig)
MAL_CLIENT_ID=

# Default MAL username for /watching and /completed (optional)
MAL_USERNAME=
# Guild ID for guild-scoped command deploy and startup message (optional, 17-20 digit snowflake)
DEV_GUILD=

# Unused for now (only needed for HTTP interactions)
# PUBLIC_KEY=

# Set to "debug" for verbose logs (optional)
# LOG_LEVEL=info
